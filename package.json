{
  "name": "extension-practice",
  "publisher": "zakzakst",
  "displayName": "extension-practice",
  "description": "extension-practice",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension-practice.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "extension-practice.countSelectedText",
        "title": "Count Selected Text"
      },
      {
        "command": "extension-practice.toUppercase",
        "title": "Convert Selected Text To Uppercase"
      },
      {
        "command": "extension-practice.openMyFolder",
        "title": "マイフォルダを開く"
      },
      {
        "command": "extension-practice.clicked",
        "title": "サイドパネルクリック"
      },
      {
        "command": "extension-practice.openGoogle",
        "title": "Open Google"
      },
      {
        "command": "extension-practice.currentFolder",
        "title": "現在のフォルダパスを表示"
      }
    ],
    "configuration": {
      "title": "マイフォルダ",
      "properties": {
        "extension-practice.myFolders": {
          "type": "array",
          "default": [],
          "description": "マイフォルダのリスト"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myFolders",
          "title": "My Folder",
          "icon": "media/icon-my-folders.svg"
        }
      ]
    },
    "views": {
      "myFolders": [
        {
          "id": "myFoldersView",
          "name": "myFolders",
          "icon": "media/icon-my-folders.svg"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "extension-practice.clicked",
          "when": "viewItem == folder"
        }
      ]
    }
  },
  "scripts": {
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/extensionTests.js",
    "pretest": "npm run compile-web",
    "vscode:prepublish": "npm run package-web",
    "compile-web": "npm run check-types && npm run lint && node esbuild.js",
    "watch-web": "npm-run-all -p watch-web:*",
    "watch-web:esbuild": "node esbuild.js --watch",
    "watch-web:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-web": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. .",
    "vsce-package": "vsce package --out download/extension.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/assert": "^1.5.11",
    "eslint": "^9.39.3",
    "typescript-eslint": "^8.56.1",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3",
    "@vscode/test-web": "^0.0.80",
    "esbuild": "^0.27.3",
    "glob": "^13.0.6",
    "npm-run-all": "^4.1.5",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "assert": "^2.1.0"
  }
}
